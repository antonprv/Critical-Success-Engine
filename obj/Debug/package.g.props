<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">lanternfestival</PackageJsonName>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">1.0.0</PackageJsonVersion>
    <PackageJsonDescription Condition="$(PackageJsonDescription) == ''"></PackageJsonDescription>
    <PackageJsonMain Condition="$(PackageJsonMain) == ''">dist/js/bundle.js</PackageJsonMain>
    <PackageJsonScriptsBuild Condition="$(PackageJsonScriptsBuild) == ''">webpack</PackageJsonScriptsBuild>
    <PackageJsonScriptsClean Condition="$(PackageJsonScriptsClean) == ''">rimraf dist</PackageJsonScriptsClean>
    <PackageJsonScriptsRebuild Condition="$(PackageJsonScriptsRebuild) == ''">pnpm clean &amp;&amp; pnpm build</PackageJsonScriptsRebuild>
    <PackageJsonScriptsTypecheck Condition="$(PackageJsonScriptsTypecheck) == ''">tsc --noEmit</PackageJsonScriptsTypecheck>
    <PackageJsonScriptsStart Condition="$(PackageJsonScriptsStart) == ''">webpack-dev-server --port 8080</PackageJsonScriptsStart>
    <PackageJsonKeywords Condition="$(PackageJsonKeywords) == ''">[]</PackageJsonKeywords>
    <PackageJsonAuthor Condition="$(PackageJsonAuthor) == ''"></PackageJsonAuthor>
    <PackageJsonLicense Condition="$(PackageJsonLicense) == ''">ISC</PackageJsonLicense>
    <PackageJsonType Condition="$(PackageJsonType) == ''">commonjs</PackageJsonType>
    <PackageJsonDevdependenciesBabylonjsCore Condition="$(PackageJsonDevdependenciesBabylonjsCore) == ''">^9.22.1</PackageJsonDevdependenciesBabylonjsCore>
    <PackageJsonDevdependenciesBabylonjsInspector Condition="$(PackageJsonDevdependenciesBabylonjsInspector) == ''">^9.22.1</PackageJsonDevdependenciesBabylonjsInspector>
    <PackageJsonDevdependenciesTypesNode Condition="$(PackageJsonDevdependenciesTypesNode) == ''">^26.2.0</PackageJsonDevdependenciesTypesNode>
    <PackageJsonDevdependenciesEslint Condition="$(PackageJsonDevdependenciesEslint) == ''">^10.9.0</PackageJsonDevdependenciesEslint>
    <PackageJsonDevdependenciesHtmlWebpackPlugin Condition="$(PackageJsonDevdependenciesHtmlWebpackPlugin) == ''">^5.6.8</PackageJsonDevdependenciesHtmlWebpackPlugin>
    <PackageJsonDevdependenciesRimraf Condition="$(PackageJsonDevdependenciesRimraf) == ''">^6.0.1</PackageJsonDevdependenciesRimraf>
    <PackageJsonDevdependenciesTsLoader Condition="$(PackageJsonDevdependenciesTsLoader) == ''">^9.6.2</PackageJsonDevdependenciesTsLoader>
    <PackageJsonDevdependenciesTypescript Condition="$(PackageJsonDevdependenciesTypescript) == ''">^7.0.2</PackageJsonDevdependenciesTypescript>
    <PackageJsonDevdependenciesWebpack Condition="$(PackageJsonDevdependenciesWebpack) == ''">^5.109.2</PackageJsonDevdependenciesWebpack>
    <PackageJsonDevdependenciesWebpackCli Condition="$(PackageJsonDevdependenciesWebpackCli) == ''">^7.2.2</PackageJsonDevdependenciesWebpackCli>
    <PackageJsonDevdependenciesWebpackDevServer Condition="$(PackageJsonDevdependenciesWebpackDevServer) == ''">^6.0.0</PackageJsonDevdependenciesWebpackDevServer>
  </PropertyGroup>
</Project>