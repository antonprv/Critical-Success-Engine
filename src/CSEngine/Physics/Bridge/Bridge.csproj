<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<OutputType>Exe</OutputType>

		<WasmMainJSPath>main.js</WasmMainJSPath>
		<SelfContained>true</SelfContained>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<RootNamespace>Physics.Wasm</RootNamespace>
		<AssemblyName>PhysicsBridge</AssemblyName>

		<BaseOutputPath>..\..\Binaries\Physics\</BaseOutputPath>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>..\..\..\..\docs\Physics\Physics.xml</DocumentationFile>

		<!-- wasm runtime -->
		<WasmEnableThreads>false</WasmEnableThreads>
		<WasmEnableSIMD>true</WasmEnableSIMD>
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- лишние подсистемы рантайма -->
		<EventSourceSupport>false</EventSourceSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>

		<!-- паблишинг флаги -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<UseSystemResourceKeys>false</UseSystemResourceKeys>
		<Optimize>False</Optimize>
		<IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<IsAotCompatible>True</IsAotCompatible>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<WasmBuildNative>true</WasmBuildNative>
		<WasmEmitSymbolMap>false</WasmEmitSymbolMap>
		<Optimize>True</Optimize>
		<WasmEnableLegacyJsInterop>false</WasmEnableLegacyJsInterop>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vendor\Integration\Integration.csproj" />
	</ItemGroup>

	<UsingTask TaskName="GzipCompressFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<SourceFile ParameterType="System.String" Required="true" />
			<DestinationFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.IO.Compression" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
				using (var input = File.OpenRead(SourceFile))
				using (var output = File.Create(DestinationFile))
				using (var gzip = new GZipStream(output, CompressionLevel.SmallestSize))
				{
					input.CopyTo(gzip);
				}
				Log.LogMessage(MessageImportance.High, $"gzip: {SourceFile} -> {DestinationFile}");
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="GzipCompressWasmRuntime" AfterTargets="Publish">
		<PropertyGroup>
			<_WasmRuntimeFile>$(PublishDir)_framework\dotnet.native.wasm</_WasmRuntimeFile>
		</PropertyGroup>
		<GzipCompressFile Condition="Exists('$(_WasmRuntimeFile)')"
						SourceFile="$(_WasmRuntimeFile)"
						DestinationFile="$(_WasmRuntimeFile).gz" />
	</Target>

</Project>
