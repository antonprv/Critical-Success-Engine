<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<!-- Presence of WasmMainJSPath is what tells the SDK (once the wasm-tools
		     workload is installed) to build this as a browser-wasm app instead of
		     a normal managed assembly. -->
		<WasmMainJSPath>main.js</WasmMainJSPath>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<SelfContained>true</SelfContained>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Framework.Physics.Wasm</RootNamespace>
		<AssemblyName>PhysicsBridge</AssemblyName>

		<!-- Single-threaded WASM build on purpose: multi-threaded .NET-on-wasm needs
		     SharedArrayBuffer, which needs COOP/COEP response headers on every
		     document that embeds this worker. We're using plain postMessage between
		     JS workers instead, so keep the runtime itself single-threaded and
		     header-free. Bepu's own internal ThreadDispatcher is still disabled via
		     UseMultithreading=false when the world is created from JS (see
		     PhysicsBridge.CreateWorld) for the same reason - there is only one
		     thread available inside this wasm instance regardless. -->
		<WasmEnableThreads>false</WasmEnableThreads>

		<!-- Portable SIMD (System.Numerics.Vector<T>, which is all Bepu/FastMath use -
		     no System.Runtime.Intrinsics.X86 in the hot paths) lowers to wasm SIMD128
		     when this is on. Requires a wasm runtime with SIMD support (every browser
		     Babylon.js itself supports already). -->
		<WasmEnableSIMD>true</WasmEnableSIMD>

		<!-- Trimming + AOT are where an unmodified vendored Bepu is most likely to
		     need local iteration - leave both off for the first build that boots and
		     turn them on once Step() is confirmed working, per BUILD.md. -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\vendor\Physics.Integration\Physics.Integration.csproj" />
	</ItemGroup>

</Project>
