{
	"name": "@cse/sdf",
	"version": "1.0.0",
	"private": true,
	"description": "The SDF world: an edit list, distance bricks, a mesh tier and a ray-marched layer over Babylon.",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"exports": {
		".": "./Source/Index.ts",
		"./render": "./Source/Render/Index.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 4178 --strictPort",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test",
		"bench": "vite build --config vite.bench.config.ts --logLevel warn && node ../../../../Binaries/Bench/SDF/Bench.mjs"
	},
	"dependencies": {
		"@babylonjs/core": "^9.29.0",
		"@cse/fastmath": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.11.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
