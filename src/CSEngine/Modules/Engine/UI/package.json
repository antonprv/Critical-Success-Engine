{
  "name": "@cse/ui",
  "version": "1.0.0",
  "private": true,
  "description": "The engine's UI module: the Windows 98-7 / Tailwind toolkit and the runtime of UI documents games show.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./Source/index.ts",
    "./game": "./Source/Runtime/GameUiModule.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --project tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cse/core": "workspace:*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
