<Project Sdk="Microsoft.NET.Sdk">

	<!-- Tests of the C# physics stack (FastMath, CSPhysics, Integration) on the desktop runtime: run with `dotnet test`. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>Physics.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Math\FastMath.csproj" />
		<ProjectReference Include="..\CSPhysics.Utilities\CSPhysics.Utilities.csproj" />
		<ProjectReference Include="..\CSPhysics\CSPhysics.csproj" />
		<ProjectReference Include="..\Integration\Integration.csproj" />
	</ItemGroup>

</Project>
