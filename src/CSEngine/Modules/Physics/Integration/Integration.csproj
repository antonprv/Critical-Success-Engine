<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Physics</RootNamespace>
		<AssemblyName>Physics.Integration</AssemblyName>
		<Nullable>annotations</Nullable>
		<EnableDynamicLoading>false</EnableDynamicLoading>
		<PublishTrimmed>true</PublishTrimmed>
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Physics.Tests" />
		<!-- The bridge maps body handles to its own ids by their value (an array, not a dictionary). -->
		<InternalsVisibleTo Include="PhysicsBridge" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Math\FastMath.csproj" />
		
		<ProjectReference Include="..\CSPhysics\CSPhysics.csproj" />
		<ProjectReference Include="..\CSPhysics.Utilities\CSPhysics.Utilities.csproj" />
	</ItemGroup>

</Project>