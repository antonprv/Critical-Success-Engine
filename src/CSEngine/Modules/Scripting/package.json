{
	"name": "@cse/scripting",
	"version": "1.0.0",
	"private": true,
	"description": "C# scripting, the TypeScript side: protocol, runtime and .NET loader for C# components.",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"exports": {
		".": "./Source/Index.ts",
		"./contracts": "./Source/Contracts/Index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run --coverage"
	},
	"dependencies": {
		"@cse/datastream": "workspace:*",
		"@cse/di": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.11.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3"
	}
}
