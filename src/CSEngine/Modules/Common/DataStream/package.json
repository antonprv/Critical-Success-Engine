{
	"name": "@cse/datastream",
	"version": "1.0.0",
	"private": true,
	"description": "DataStream: tagged reactive messages shared by TypeScript and C#, and the MessagePack codec they cross with.",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"exports": {
		".": "./Source/Index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run --coverage",
		"bench": "node --experimental-strip-types --no-warnings Bench/Bench.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.11.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3"
	}
}
