{
  "name": "lanternfestival",
  "version": "1.0.0",
  "private": true,
  "description": "Lantern Festival - a browser game engine: TypeScript workers, BEPU physics in wasm, Vue + Quasar UI",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --project tsconfig.node.json && tsc --project tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "clean": "rimraf ../Binaries/Core coverage .e2e test-results playwright-report",
    "rebuild": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "quasar": "^2.34.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "pngjs": "^7.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
