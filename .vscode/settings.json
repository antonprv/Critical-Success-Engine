{
	// Save runs ESLint's fixes: Tools/CSELint wraps long lines of code and comments, the stylistic rules do the rest.
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"eslint.useFlatConfig": true,
	"eslint.workingDirectories": [
		{ "mode": "auto" }
	],
	"eslint.validate": [
		"javascript",
		"typescript",
		"json",
		"jsonc"
	]
}
